            "textpurpose":"Provenance",
            "textentryhtml":"<p>\n\tBy February 1977, Gillett G. Griffin (1928-2016), Princeton, NJ [1]; 2016, bequest of Gillett G. Griffin to the Princeton University Art Museum.\n</p>\n<p>\n\tNotes:\n\t<br />\n\t[1] According to dated slides in the Griffin archive.\n\t<br />\n</p>",
            "remarks":null
