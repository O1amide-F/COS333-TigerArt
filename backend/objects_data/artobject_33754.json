    "texts":[
        {
            "texttype":"Online",
            "textpurpose":"Provenance",
            "textentryhtml":"Fine Arts of Ancient Lands, New York, by 1978; Mary O’Boyle, by 1988; Princeton University Art Museum, 1993",
            "remarks":"Migrated from 9.35 12/2013"
